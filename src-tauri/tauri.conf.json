{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LagosFile",
  "version": "1.1.0",
  "identifier": "ng.lagosfile.app",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/lagosfile-v2/browser"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LagosFile",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Bolorunduro Valiant-Joshua",
    "copyright": "Copyright (c) 2026 Bolorunduro Valiant-Joshua",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "shell": {
      "open": true
    }
  }
}
