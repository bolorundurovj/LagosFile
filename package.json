{
  "name": "lagosfile",
  "version": "1.0.0",
  "description": "LagosFile - Lagos State Direct Assessment Tax Filing Desktop App",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --browsers=ChromeHeadlessCI",
    "test:watch": "ng test --browsers=Chrome",
    "test:coverage": "ng test --no-watch --code-coverage --browsers=ChromeHeadlessCI",
    "test:rust": "cd src-tauri && cargo test",
    "test:rust:coverage": "cd src-tauri && cargo llvm-cov --html",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "pack:ext:chrome": "node scripts/pack-extensions.mjs chrome",
    "pack:ext:firefox": "node scripts/pack-extensions.mjs firefox",
    "pack:ext": "node scripts/pack-extensions.mjs",
    "sync:version": "node scripts/sync-version.mjs",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "lint:rust": "cd src-tauri && cargo clippy --workspace --all-targets -- -D warnings",
    "lint:rust:fix": "cd src-tauri && cargo clippy --fix --allow-dirty --allow-no-vcs",
    "format:rust": "cd src-tauri && cargo fmt",
    "format:all": "npm run lint:fix && npm run format:rust",
    "generate:notices": "node scripts/generate-third-party-notices.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@angular/animations": "^19.0.0",
    "@angular/common": "^19.0.0",
    "@angular/compiler": "^19.0.0",
    "@angular/core": "^19.0.0",
    "@angular/forms": "^19.0.0",
    "@angular/platform-browser": "^19.0.0",
    "@angular/platform-browser-dynamic": "^19.0.0",
    "@angular/router": "^19.0.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "lucide-angular": "^1.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.6.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.0.0",
    "@angular/cli": "^19.0.0",
    "@angular/compiler-cli": "^19.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "21.0.1",
    "eslint": "^9.39.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jasmine-core": "~5.4.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "license-checker": "^25.0.1",
    "sass": "^1.80.0",
    "typescript": "~5.6.0",
    "typescript-eslint": "8.46.4"
  }
}
