{
  "manifest_version": 2,
  "name": "LagosFile for LIRS",
  "version": "1.0.0",
  "description": "Auto-populate the LIRS e-Tax Tax Calculator from LagosFile computed filing data",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "https://etax.lirs.gov.ng/*",
    "https://etax.lirs.net/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": false
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "LagosFile for LIRS",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://etax.lirs.gov.ng/*",
        "https://etax.lirs.net/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
